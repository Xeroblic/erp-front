# Normalize every tracked text file to LF on every platform.
* text=auto eol=lf

# Binary assets must never be modified by line-ending normalization.
*.ico binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.png binary
*.webp binary
*.xlsx binary
*.zip binary

# Prettier may combine spaces and tabs to preserve Markdown nesting.
*.md whitespace=-space-before-tab
