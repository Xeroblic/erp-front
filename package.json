{
	"name": "zentria-vite",
	"version": "2.6.0",
	"private": true,
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite",
		"test": "vitest",
		"test:run": "vitest run",
		"test:related": "vitest related --run",
		"test:e2e": "playwright test",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint --fix . --ext .js,.jsx,.ts,.tsx",
		"lint:changed": "node scripts/lintChanged.mjs",
		"lint:imports": "eslint . --ext .js,.jsx,.ts,.tsx --no-eslintrc --no-inline-config --config .eslintrc.imports.json",
		"typecheck": "tsc --noEmit",
		"check:eol": "node scripts/checkLineEndings.mjs",
		"quality:style": "pnpm run check:eol && pnpm run prettier:check && pnpm run lint:imports",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"icon": "svgr SvgIcons -d src/components/icon/svg-icons --typescript --no-prettier"
	},
	"engines": {
		"node": ">=22.14.0",
		"pnpm": ">=9.0.0"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
