import React, { useEffect, useRef, useState } from 'react';
import { useAppDispatch, useAppSelector } from '@/store';
import {
	fetchNotifications,
	upsertMany,
	markDelivered,
} from '@/store/slices/notifications/notificationsSlice';
import type { UserNotificationDTO } from '@/interface/notifications.interface';
import { tokenManager } from '@/services/auth/tokenManager';

const NotificationsStreamProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
	const dispatch = useAppDispatch();
	const { items } = useAppSelector((state) => state.notifications ?? { items: [] });
	const processingRef = useRef<Set<number>>(new Set()); // IDs en proceso de marcado (temporal)
	const lastSeenCountRef = useRef<Map<number, number>>(new Map()); // Último aggregate_count visto por ID

	const [useSSE, setUseSSE] = useState(true);
	const eventSourceRef = useRef<EventSource | null>(null);
	const connectionOpenedRef = useRef(false);

	useEffect(() => {
		if (typeof window !== 'undefined' && 'Notification' in window) {

			if (Notification.permission === 'default') {
				console.log('⏳ [NOTIF] Solicitando permiso al usuario...');
				Notification.requestPermission()
					.then((permission) => {
						console.log('🔔 [NOTIF] Resultado del permiso:', permission);
						if (permission === 'granted') {
							console.log('✅ [NOTIF] ¡Permiso otorgado!');
						} else if (permission === 'denied') {
							console.error('[NOTIF] Permiso denegado.');
						}
					})
					.catch((err) => {
						console.error('[NOTIF] Error al solicitar permiso:', err);
					});
			} else if (Notification.permission === 'granted') {
				console.log('✅ [NOTIF] Permiso ya otorgado previamente.');
			} else if (Notification.permission === 'denied') {
				console.error('[NOTIF] Permiso denegado previamente.');
			}
		} else {
			console.error('[NOTIF] Notification API NO soportada');
		}
	}, []);

	useEffect(() => {
		console.log('🔄 [NOTIF] Configurando sistema de notificaciones...');

		const initialLoad = () => {
			console.log('� [NOTIF] Carga inicial del inbox...');
			dispatch(fetchNotifications({ per_page: 20 }))
				.unwrap()
				.then((result) => {
					console.log(`✅ [NOTIF] Inbox cargado: ${result.items.length} notificaciones`);
				})
				.catch((err) => {
					console.error('[NOTIF] Error cargando inbox:', err);
				});
		};

		initialLoad();

		if (useSSE && typeof EventSource !== 'undefined') {
			console.log('🌊 [NOTIF] Intentando conexión SSE...');
			setupSSEConnection();
		} else {
			console.log('🔄 [NOTIF] SSE no disponible, usando polling...');
			return setupPolling();
		}

		return () => {
			// Cleanup
			if (eventSourceRef.current) {
				console.log('🛑 [NOTIF] Cerrando conexión SSE...');
				eventSourceRef.current.close();
				eventSourceRef.current = null;
			}
		};
	}, [dispatch, useSSE]);

	const setupSSEConnection = () => {
		try {
			// Obtener token usando tokenManager
			const token = tokenManager.getAccessToken();
			if (!token) {
				console.error('[NOTIF] No hay token de autenticación');
				setUseSSE(false);
				return;
			}

			// Validar que el token sea válido
			if (!tokenManager.isTokenValid(token)) {
				console.error('[NOTIF] Token expirado o inválido');
				setUseSSE(false);
				return;
			}

			// Construir URL con token en query param (EventSource no soporta headers custom)
			const baseURL = import.meta.env.VITE_API_URL || 'http://localhost:8000/api';
			const lastEventId = getLastEventId();
			// history=1 para recibir notificaciones existentes también (útil para debugging)
			const url = `${baseURL}/me/notifications/stream?access_token=${token}&lastEventId=${lastEventId}&history=1`;

			console.log('🌊 [NOTIF] Conectando a SSE...');

			const eventSource = new EventSource(url);
			eventSourceRef.current = eventSource;

			// Evento: Conexión abierta
			eventSource.onopen = () => {
				console.log('✅ [NOTIF] Conexión SSE establecida');
				connectionOpenedRef.current = true; // Marcar que se abrió exitosamente
			};

			// Evento: Notificación nueva
			eventSource.addEventListener('notification', (event) => {
				try {
					const notification = JSON.parse(event.data) as UserNotificationDTO;
					console.log('🔔 [NOTIF] Nueva notificación SSE:', notification.id);

					// Actualizar último ID
					saveLastEventId(notification.id);

					// Agregar al store
					dispatch(upsertMany([notification]));
				} catch (err) {
					console.error('[NOTIF] Error procesando evento SSE:', err);
				}
			});

			// Evento: Error (también se dispara en cierre normal del servidor)
			eventSource.onerror = (error) => {
				// Cerrar conexión
				eventSource.close();
				eventSourceRef.current = null;

				// Si NUNCA se abrió la conexión (onopen nunca se disparó), es error de autenticación
				if (!connectionOpenedRef.current) {
					console.error('[NOTIF] Error de autenticación SSE (nunca se conectó):', error);
					console.log('📊 [NOTIF] Estado:', {
						readyState: eventSource.readyState,
						url: eventSource.url,
					});
					console.log('🔄 [NOTIF] Cambiando a polling...');
					setUseSSE(false);
					return;
				}

				// Si la conexión se abrió pero luego falló, es timeout normal del servidor (60s)
				// Reconectar inmediatamente sin backoff
				console.log(
					'⏱️ [NOTIF] Timeout del servidor (60s alcanzados), reconectando...',
				);

				// Reset ref para nueva conexión
				connectionOpenedRef.current = false;

				// Reconectar después de 1 segundo
				setTimeout(() => {
					if (useSSE) {
						// Solo si SSE sigue habilitado
						setupSSEConnection();
					}
				}, 1000);
			};
		} catch (err) {
			console.error('[NOTIF] Error configurando SSE:', err);
			setUseSSE(false);
		}
	};

	// Configurar polling (fallback)
	const setupPolling = () => {
		console.log('� [NOTIF] Configurando polling cada 60 segundos...');

		const fetchData = () => {
			const timestamp = new Date().toLocaleTimeString();

			dispatch(fetchNotifications({ per_page: 20 }))
				.unwrap()
				.then((result) => {
					console.log(
						`✅ [NOTIF] [${timestamp}] Polling: ${result.items.length} notificaciones`,
					);
				})
				.catch((err) => {
					console.error(`[NOTIF] [${timestamp}] Error en polling:`, err);
				});
		};

		const interval = setInterval(fetchData, 60000);

		const handleFocus = () => fetchData();
		const handleVisibility = () => {
			if (!document.hidden) fetchData();
		};

		window.addEventListener('focus', handleFocus);
		document.addEventListener('visibilitychange', handleVisibility);

		return () => {
			console.log('🛑 [NOTIF] Limpiando polling...');
			clearInterval(interval);
			window.removeEventListener('focus', handleFocus);
			window.removeEventListener('visibilitychange', handleVisibility);
		};
	};

	// Helpers para gestionar último ID de evento
	const getLastEventId = (): number => {
		const stored = sessionStorage.getItem('notif_last_event_id');
		return stored ? parseInt(stored, 10) : 0;
	};

	const saveLastEventId = (id: number): void => {
		const current = getLastEventId();
		if (id > current) {
			sessionStorage.setItem('notif_last_event_id', id.toString());
		}
	};

	// Detectar nuevas notificaciones y mostrar popups nativos
	useEffect(() => {
		if (!Array.isArray(items)) return;

		// Filtrar notificaciones que cumplan UNA de estas condiciones:
		// 1. delivered_to_user = false (nunca entregada)
		// 2. aggregate_count cambió desde la última vez que la vimos (actualización)
		const newItems = items.filter((n) => {
			if (processingRef.current.has(n.id)) return false; // Skip si está en proceso

			const lastCount = lastSeenCountRef.current.get(n.id);
			const currentCount = n.aggregate_count ?? 1;

			// Caso 1: No entregada aún
			if (n.delivered_to_user === false) return true;

			// Caso 2: Ya fue entregada PERO el aggregate_count cambió (significa que hay actualización)
			if (n.delivered_to_user === true && lastCount !== undefined && currentCount > lastCount) {
				console.log(
					`🔄 [NOTIF] Actualización detectada en ID ${n.id}: count ${lastCount} → ${currentCount}`,
				);
				return true;
			}

			return false;
		});

		if (newItems.length === 0) return;

		console.log('🆕 [NOTIF] Notificaciones para mostrar:', newItems.length);
		newItems.forEach((n, idx) => {
			const lastCount = lastSeenCountRef.current.get(n.id);
			console.log(
				`  ${idx + 1}. ID: ${n.id} | delivered: ${n.delivered_to_user} | count: ${lastCount ?? 0} → ${n.aggregate_count} | ${n.event?.type_key}`,
			);
		});

		newItems.forEach((n) => {
			// Marcar como en proceso TEMPORALMENTE
			processingRef.current.add(n.id);

			// Actualizar último count visto
			lastSeenCountRef.current.set(n.id, n.aggregate_count ?? 1);

			// 1. Mostrar popup nativo
			showNativeNotification(n);

			// 2. Marcar como entregada en el backend
			dispatch(markDelivered({ ids: [n.id] }))
				.unwrap()
				.then(() => {
					console.log('✅ [NOTIF] Marcada como entregada en backend:', n.id);
				})
				.catch((err) => {
					console.error('[NOTIF] Error marcando como entregada:', n.id, err);
				})
				.finally(() => {
					// Remover del processing después de 2 segundos
					setTimeout(() => {
						processingRef.current.delete(n.id);
					}, 2000);
				});
		});
	}, [items, dispatch]);

	// Función global para resetear sistema de entrega (debugging/testing)
	useEffect(() => {
		(window as any).resetNotificationDelivery = () => {
			console.log(
				'🔄 [NOTIF] Para resetear el sistema de entrega, usa el endpoint POST /me/notifications/delivered-all',
			);
			console.log('   O ejecuta: dispatch(markAllDelivered()) desde el código.');
		};

		return () => {
			delete (window as any).resetNotificationDelivery;
		};
	}, []);

	// Mostrar notificación nativa de Windows
	const showNativeNotification = (n: UserNotificationDTO): void => {
		if (typeof window === 'undefined' || !('Notification' in window)) {
			return;
		}

		if (Notification.permission !== 'granted') {
			return;
		}

		// Construir título más descriptivo
		const module = n.event?.module_label || n.event?.module || '';
		const typeLabel = n.event?.type_label || n.event?.type_key || 'Notificación';
		const title = module ? `${module} - ${typeLabel}` : typeLabel;

		// Body con más contexto
		let body = n.message || typeLabel;
		
		// Agregar contador si hay agregación
		if (n.aggregate_count && n.aggregate_count > 1) {
			body = `📊 ${n.aggregate_count} eventos similares\n${body}`;
		}

		// Agregar timestamp
		const time = n.created_at
			? new Date(n.created_at).toLocaleTimeString('es-CL', {
					hour: '2-digit',
					minute: '2-digit',
			  })
			: '';
		if (time) {
			body = `${body}\n🕐 ${time}`;
		}

		const icon = '/logo192.png?v=zentria1';
		const tag = `notification-${n.id}`; // Usar solo ID para que se reemplace si es el mismo

		try {
			const notification = new Notification(title, {
				body,
				icon,
				badge: icon,
				tag,
				requireInteraction: false, // Permitir cierre automático
				silent: false, // Reproducir sonido
				// Configuración adicional para Windows
				...(n.event?.priority === 'P1' && { urgency: 'high' as any }),
			});

			// Auto-cerrar después de 5 segundos
			const autoCloseTimeout = setTimeout(() => {
				notification.close();
				console.log('⏱️ [NOTIF] Auto-cerrada después de 5s:', n.id);
			}, 5000);

			notification.onclick = () => {
				console.log('👆 [NOTIF] Click en notificación:', n.id);
				clearTimeout(autoCloseTimeout); // Cancelar auto-cierre
				window.focus();
				notification.close();
			};

			notification.onclose = () => {
				clearTimeout(autoCloseTimeout); // Limpiar timeout si se cierra manualmente
			};

			notification.onshow = () => {
				console.log('✅ [NOTIF] Popup mostrado:', n.id);
			};

			notification.onerror = (err) => {
				console.error('[NOTIF] Error mostrando popup:', n.id, err);
				clearTimeout(autoCloseTimeout);
			};

			console.log('🔔 [NOTIF] Popup creado:', n.id, '|', title);
		} catch (err) {
			console.error('[NOTIF] Error al crear popup:', err);
		}
	};

	return <>{children}</>;
};

export default NotificationsStreamProvider;
